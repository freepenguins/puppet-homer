<%- | String $db_user, String $db_password | -%>
# Generated by the homer7_native puppet module from
# https://github.com/sipcapture/heplify-server/blob/master/example/homer7_config/heplify-server.toml
# Values below are ported 1:1 from the HEPLIFYSERVER_* environment
# variables in homer7-docker's hom7-prom-all/docker-compose.yml.

HEPAddr = "0.0.0.0:9060"
HEPTCPAddr = "0.0.0.0:9061"
HEPTLSAddr = "0.0.0.0:9061"
HEPWSAddr = ""
ESAddr = ""
ESDiscovery = false

LokiURL = "http://127.0.0.1:3100/api/prom/push"
LokiBulk = 200
LokiTimer = 2
LokiBuffer = 100000
LokiHEPFilter = [1,5,100]
LokiAllowOutOfOrder = false
LokiCustomLabels = []

ForceHEPPayload = []

PromAddr = "0.0.0.0:9096"
PromTargetIP = ""
PromTargetName = ""

DBShema = "homer7"
DBDriver = "postgres"
DBAddr = "127.0.0.1:5432"
DBUser = "<%= $db_user %>"
DBPass = "<%= $db_password %>"
DBDataTable = "homer_data"
DBConfTable = "homer_config"
DBBulk = 200
DBTimer = 4
DBBuffer = 400000
DBWorker = 8
DBRotate = true
DBDropDays = 5

Dedup = false
DiscardMethod = []
AlegIDs = []
CustomHeader = []
SIPHeader = []

LogDbg = ""
LogLvl = "info"
LogStd = true
LogSys = false

Config = "/etc/heplify-server/heplify-server.toml"
ConfigHTTPAddr = ""
